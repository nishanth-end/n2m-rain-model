{
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index.py"
    },
    {
      "source": "/download/(.*)",
      "destination": "/api/index.py"
    },
    {
      "source": "/css/(.*)",
      "destination": "/docs/css/$1"
    },
    {
      "source": "/js/(.*)",
      "destination": "/docs/js/$1"
    },
    {
      "source": "/(.*\\.html)",
      "destination": "/docs/$1"
    },
    {
      "source": "/",
      "destination": "/docs/index.html"
    }
  ]
}
