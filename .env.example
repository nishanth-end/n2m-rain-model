# =============================================================================
# Bengaluru Flood Susceptibility Model Backend Configuration (.env)
# =============================================================================

# Operational Mode
MODE=historical_replay

# Replay Dataset and Model Paths (defaults to handover_member3 folder)
REPLAY_PARQUET_PATH=handover_member3/flood_replay_E2022_09.parquet
STATIC_CELLS_PATH=handover_member3/cells_static.csv
PIXEL_MAP_PATH=handover_member3/cell_pixel_map.csv
FEATURES_PATH=handover_member3/features.json
THRESHOLDS_PATH=handover_member3/thresholds.json
HOLDOUT_MODEL_PATH=handover_member3/flood_xgb_holdout_E2022_09.json
FINAL_MODEL_PATH=handover_member3/flood_xgb.json

# Experimental Live Pipeline Scaffolding (STRICTLY DISABLED BY DEFAULT)
# Do NOT enable for operational alert generation.
ENABLE_EXPERIMENTAL_LIVE_PIPELINE=false

# Optional Telegram Demo / Sandbox Integration (DISABLED BY DEFAULT)
# Only for private developer demonstration with historical replay data.
# NEVER configure public channels or operational warning channels.
TELEGRAM_ENABLED=false
TELEGRAM_BOT_TOKEN=YOUR_TELEGRAM_BOT_TOKEN_HERE
TELEGRAM_CHAT_ID=YOUR_PRIVATE_CHAT_ID_HERE
TELEGRAM_AUTHORIZED_CHAT_IDS=YOUR_PRIVATE_CHAT_ID_HERE,ANOTHER_AUTHORIZED_CHAT_ID
TELEGRAM_BOT_USERNAME=N2M_Flood_Demo_Bot

# CORS Allowed Origins (comma-separated, e.g. https://your-app.vercel.app, or * for all)
CORS_ORIGINS=*
